{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "build": {
    "env": {
      "VITE_PORTFOLIO_VIEWS_URL": "https://countty.linkitofficial25.workers.dev",
      "VITE_PORTFOLIO_VIEWS_SLUG": "strykerinside:resume"
    }
  },
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{content/**,server/**,lib/portfolio/**}",
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
