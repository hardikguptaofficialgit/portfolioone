{
    "crons": [
        {
            "path": "/api/newsletter/dispatch",
            "schedule": "*/15 * * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/"
        }
    ]
}
