# Optional: hosted view counter (browser → Cloudflare Countty worker). No Vercel API/KV.
# 1) npx countty@latest init → npm run deploy
# 2) npx countty create strykerinside:resume
# VITE_PORTFOLIO_VIEWS_URL=https://your-countty.workers.dev
# VITE_PORTFOLIO_VIEWS_SLUG=strykerinside:resume

# GitHub Models - required only if you use Ask AI / chat on the site
GITHUB_TOKEN=
# Optional (default: openai/gpt-4o)
GITHUB_MODELS_MODEL=openai/gpt-4o
